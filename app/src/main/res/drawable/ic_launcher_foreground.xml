<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a rep-counter ring (faint track + progress arc + amber marker)
  with a check mark breaking out of it. Everything sits inside the 66dp adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- track -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 54,78 A24,24 0 1,1 54,30"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.28" />
    <!-- progress arc -->
    <path
        android:pathData="M54,30 A24,24 0 1,1 31.45,62.21"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- marker at the end of the arc -->
    <path
        android:fillColor="#FFFBBF24"
        android:pathData="M26.95,62.21 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <!-- check mark -->
    <path
        android:pathData="M42,55 L51,64 L76,33"
        android:strokeWidth="7"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
