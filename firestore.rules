rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return getRole() in ['admin_officer','deputy_registrar','deputy_director','director','super_admin'];
    }

    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth.uid == userId || getRole() == 'super_admin';
      allow update: if request.auth.uid == userId || getRole() == 'super_admin';
      allow delete: if getRole() == 'super_admin';
    }

    match /schools/{schoolId} {
      allow read:  if request.auth != null;
      allow write: if getRole() == 'super_admin';
    }

    match /blackout_dates/{dateId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /venues/{venueId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /venue_holds/{holdId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /registrations/{regId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.userId;
    }

    match /notifications/{notifId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId || getRole() == 'super_admin';
    }

    match /gallery/{galleryId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /certificates/{certId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /attendance/{attId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /white_papers/{paperId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    match /placement_locks/{lockId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
